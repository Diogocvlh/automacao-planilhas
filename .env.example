# Somente exemplos. Copie para .env e preencha localmente com acessos autorizados.
# Caminhos relativos são resolvidos a partir da raiz deste projeto.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
GOOGLE_SPREADSHEET_ID=SUBSTITUA_ID_DA_SUA_PLANILHA_DE_TESTE
VIBRA_BASES_FILE=config/bases-vibra.json
VIBRA_BASE_DEMO_USER=SUBSTITUA_USUARIO
VIBRA_BASE_DEMO_PASSWORD=SUBSTITUA_SENHA

# Usadas apenas pelo coletor com login manual. Não há senha desse portal no código.
IPIRANGA_BASE_NOME=SUBSTITUA_NOME_DA_BASE
IPIRANGA_BASE_CNPJ=SUBSTITUA_CNPJ_AUTORIZADO
IPIRANGA_BASE_LOCALIDADE=SUBSTITUA_LOCALIDADE
IPIRANGA_BASE_PONTO_ENTREGA=SUBSTITUA_PONTO_DE_ENTREGA
IPIRANGA_BASE_TITULO_BLOCO=SUBSTITUA_TITULO_DO_BLOCO
IPIRANGA_BASE_OPCAO_DROPDOWN=SUBSTITUA_TEXTO_DA_OPCAO
IPIRANGA_DESCONTO_POR_LITRO=0
